<script>
(function(){
'use strict';
var KEY='renton-priskalkyl-v1';
var CURS=['EUR','USD','CNY','GBP','NOK','DKK'];
var DEF={name:'Avhärdare 20 L med WiFi-ventil (exempel)',price:285,cur:'EUR',qty:50,supDisc:0,freight:6500,freightCur:'SEK',
  duty:0,other:35,overhead:5,fxBuf:2,N:5490,R:7996,campaign:0,vat:25,targetTG:35,step:'5',vol:120,
  cvAmt:1000,cvFrom:'EUR',cvTo:'SEK',
  rates:{EUR:11.051,USD:9.9317,CNY:1.4889,GBP:13.1558,NOK:1.0354,DKK:1.4814}};
var s=JSON.parse(JSON.stringify(DEF)), saved=[];
try{
  var raw=JSON.parse(localStorage.getItem(KEY)||'null');
  if(raw){ if(raw.cur){for(var k in raw.cur)s[k]=raw.cur[k]; s.rates=Object.assign({},DEF.rates,raw.cur.rates||{});} saved=raw.saved||[]; }
}catch(e){}
function persist(){try{localStorage.setItem(KEY,JSON.stringify({cur:s,saved:saved}))}catch(e){}}

var $=function(id){return document.getElementById(id)};
function num(v){var n=parseFloat(String(v).replace(/[\s ]/g,'').replace(',','.'));return isFinite(n)?n:0}
function fmt(n,d){d=d||0;return isFinite(n)?n.toLocaleString('sv-SE',{minimumFractionDigits:d,maximumFractionDigits:d}):'–'}
function kr(n){return fmt(n)+' kr'}
function pct(n){return fmt(n*100,1)+' %'}
function plain(n,d){return isFinite(n)?String(Math.round(n*Math.pow(10,d))/Math.pow(10,d)).replace('.',','):''}

/* Kärnan: m är en faktor på alla valutakurser, används för känslighetsanalysen. */
function calc(st,m){
  if(m===undefined)m=1;
  var rate=function(c){return c==='SEK'?1:(st.rates[c]||0)*(1+st.fxBuf/100)*m};
  var qty=st.qty>0?st.qty:1;
  var goods=st.price*(1-st.supDisc/100)*rate(st.cur);
  var freight=st.freight*rate(st.freightCur)/qty;
  var duty=(goods+freight)*st.duty/100;
  var sub=goods+freight+duty+st.other;
  var oh=sub*st.overhead/100;
  var cost=sub+oh;
  var neff=st.N*(1-st.campaign/100);
  var tb=neff-cost;
  var vat=st.vat/100;
  return {rate:rate(st.cur),goods:goods,freight:freight,duty:duty,oh:oh,cost:cost,neff:neff,tb:tb,
    tg:neff>0?tb/neff:NaN, markup:cost>0?tb/cost:NaN,
    d:st.R>0?1-st.N/st.R:NaN, af:st.R>0?(st.R-neff)/st.R:NaN, afKr:st.R-neff,
    direct:st.R>0?(st.R-cost)/st.R:NaN, rin:st.R*(1+vat), vatKr:st.R*vat,
    floor:cost/(1-Math.min(st.targetTG,99.9)/100)/(1-Math.min(st.campaign,99.9)/100)};
}

function opts(el,list){el.innerHTML=list.map(function(c){return '<option>'+c+'</option>'}).join('')}
opts($('cur'),CURS.concat('SEK')); opts($('freightCur'),['SEK'].concat(CURS));
opts($('cvFrom'),CURS.concat('SEK')); opts($('cvTo'),['SEK'].concat(CURS));

function fill(){ /* skriver tillståndet till inmatningsfälten */
  document.querySelectorAll('[data-k]').forEach(function(el){
    var v=s[el.dataset.k];
    el.value=(el.tagName==='SELECT'||el.dataset.text)?v:plain(v,4);
  });
  $('rates').innerHTML=CURS.map(function(c){
    return '<tr><td>'+c+'</td><td><input id="rate-'+c+'" data-rate="'+c+'" inputmode="decimal" aria-label="Kurs '+c+'" value="'+plain(s.rates[c],4)+'"></td><td id="eff-'+c+'"></td></tr>';
  }).join('');
}
function setIn(id,v){var el=$(id); if(document.activeElement!==el) el.value=v}
function txt(id,v){$(id).textContent=v}

function render(){
  var c=calc(s);
  txt('s-cost',fmt(c.cost)); txt('s-n',fmt(s.N)); txt('s-tg',fmt(c.tg*100,1)); txt('s-tb',fmt(c.tb));
  var p=$('s-pill'), t=s.targetTG/100;
  if(c.tb<0){p.className='pill crit';p.textContent='Förlust'}
  else if(c.tg<t){p.className='pill warn';p.textContent='Under mål'}
  else{p.className='pill good';p.textContent='Når målet'}

  txt('b-rate',s.cur==='SEK'?'':'à '+fmt(c.rate,4)+' kr/'+s.cur);
  txt('b-goods',kr(c.goods)); txt('b-freight',kr(c.freight)); txt('b-duty',kr(c.duty));
  txt('b-other',kr(s.other)); txt('b-oh',kr(c.oh)); txt('b-cost',kr(c.cost));

  setIn('N',plain(s.N,0)); setIn('tg',plain(c.tg*100,1)); setIn('markup',plain(c.markup*100,1));
  setIn('Rex',plain(s.R,0)); setIn('Rin',plain(c.rin,0)); setIn('d',plain(c.d*100,1));

  var tot=Math.max(c.rin,1), seg=function(id,v){$(id).style.flex='0 0 '+Math.max(0,Math.min(100,v/tot*100))+'%'};
  seg('g-cost',Math.min(c.cost,c.rin)); seg('g-tb',c.tb); seg('g-af',c.afKr); seg('g-vat',c.vatKr);
  txt('l-cost',kr(c.cost)); txt('l-tb',kr(c.tb)); txt('l-af',kr(c.afKr)); txt('l-vat',kr(c.vatKr));

  txt('p-neff',kr(c.neff)); txt('p-af',pct(c.af)+' · '+kr(c.afKr));
  txt('p-direct',pct(c.direct)+' · '+kr(s.R-c.cost)); txt('p-floor',kr(c.floor));

  /* Prisstege */
  var step=num(s.step)/100, rows='';
  for(var i=-3;i<=3;i++){
    var st=Object.assign({},s,{N:s.N*(1+i*step)}), x=calc(st);
    rows+='<tr class="'+(i===0?'now':'pick')+'" data-n="'+st.N+'" tabindex="'+(i===0?-1:0)+'"><td>'+kr(st.N)+(i?' <span style="color:var(--muted);font-weight:400">'+(i>0?'+':'−')+fmt(Math.abs(i*step*100),1)+' %</span>':'')+'</td><td>'+pct(x.d)+'</td><td class="'+(x.tb<0?'neg':x.tg>=t?'ok':'')+'">'+pct(x.tg)+'</td><td class="'+(x.tb<0?'neg':'')+'">'+kr(x.tb)+'</td><td>'+kr(x.tb*s.vol)+'</td></tr>';
  }
  $('ladder').innerHTML=rows;

  /* Valutakänslighet */
  var hasFx=s.cur!=='SEK'||(s.freightCur!=='SEK'&&s.freight>0);
  var lead=s.cur!=='SEK'?s.cur:s.freightCur;
  txt('fx-h',hasFx?'kr/'+lead:'kr');
  txt('fx-lead',hasFx?'Så påverkas marginalen om kronan rör sig mot '+lead+' medan ÅF-priset ligger kvar på '+kr(s.N)+'.':'Inköpet är i kronor, så marginalen påverkas inte av valutakursen.');
  rows='';
  [-10,-5,0,5,10].forEach(function(dv){
    var x=calc(s,1+dv/100);
    rows+='<tr class="'+(dv===0?'now':'')+'"><td>'+(dv===0?'Idag':(dv>0?'+':'−')+Math.abs(dv)+' %')+'</td><td>'+(hasFx?fmt((s.rates[lead]||0)*(1+s.fxBuf/100)*(1+dv/100),3):'–')+'</td><td>'+kr(x.cost)+'</td><td class="'+(x.tb<0?'neg':'')+'">'+kr(x.tb)+'</td><td class="'+(x.tb<0?'neg':x.tg>=t?'ok':'')+'">'+pct(x.tg)+'</td></tr>';
  });
  $('fx').innerHTML=rows;
  var a=calc(s,0).cost, b=c.cost-a, note='';
  if(hasFx&&b>0){
    var m0=(c.neff-a)/b-1, mt=(c.neff*(1-t)-a)/b-1;
    note=(m0>0?'Valutan kan bli '+fmt(m0*100,1)+' % dyrare innan täckningsbidraget är noll.':'Täckningsbidraget är redan noll eller negativt vid dagens kurs.')+' '+
         (mt>0?'Målet på '+fmt(s.targetTG,0)+' % håller upp till '+fmt(mt*100,1)+' % dyrare valuta.':'Målet på '+fmt(s.targetTG,0)+' % kräver '+fmt(-mt*100,1)+' % billigare valuta eller högre pris.');
  }
  txt('fx-note',note);

  /* Växlare och kurser */
  var r=function(cu){return cu==='SEK'?1:(s.rates[cu]||0)};
  var out=r(s.cvTo)>0?s.cvAmt*r(s.cvFrom)/r(s.cvTo):NaN;
  txt('cvOut',fmt(s.cvAmt,2)+' '+s.cvFrom+' = '+fmt(out,2)+' '+s.cvTo);
  txt('cvNote',s.cvFrom!==s.cvTo&&r(s.cvFrom)>0?'1 '+s.cvFrom+' = '+fmt(r(s.cvFrom)/r(s.cvTo),4)+' '+s.cvTo+'. Med valutapåslaget på '+fmt(s.fxBuf,1)+' %: '+fmt(out*(1+s.fxBuf/100),2)+' '+s.cvTo+'.':'');
  CURS.forEach(function(cu){txt('eff-'+cu,fmt(s.rates[cu]*(1+s.fxBuf/100),4))});

  /* Sparade */
  $('saved-empty').style.display=saved.length?'none':'block';
  $('saved').innerHTML=saved.map(function(it,i){
    var x=calc(it);
    return '<tr><td style="white-space:normal;min-width:140px">'+esc(it.name||'Namnlös')+'</td><td>'+kr(x.cost)+'</td><td>'+kr(it.N)+'</td><td>'+kr(x.rin)+'</td><td class="'+(x.tb<0?'neg':'')+'">'+pct(x.tg)+'</td><td>'+kr(x.tb)+'</td><td><button class="linkbtn" type="button" data-load="'+i+'">Öppna</button><button class="linkbtn" type="button" data-del="'+i+'" style="color:var(--crit)">Ta bort</button></td></tr>';
  }).join('');
  persist();
}
function esc(t){return String(t).replace(/[&<>"]/g,function(ch){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[ch]})}

/* Händelser */
document.addEventListener('input',function(e){
  var el=e.target, k=el.dataset&&el.dataset.k;
  if(k){ s[k]=(el.tagName==='SELECT'||el.dataset.text)?el.value:num(el.value); render(); return; }
  if(el.dataset&&el.dataset.rate){ s.rates[el.dataset.rate]=num(el.value); render(); return; }
  var v=num(el.value), c=calc(s), camp=1-Math.min(s.campaign,99.9)/100;
  switch(el.id){
    case 'N': s.N=v; break;
    case 'tg': if(v<100) s.N=c.cost/(1-v/100)/camp; break;
    case 'markup': s.N=c.cost*(1+v/100)/camp; break;
    case 'd': s.N=s.R*(1-v/100); break;
    case 'Rex': s.R=v; break;
    case 'Rin': s.R=v/(1+s.vat/100); break;
    default: return;
  }
  render();
});
document.addEventListener('change',function(e){ if(e.target.tagName==='SELECT') e.target.dispatchEvent(new Event('input',{bubbles:true})); });
document.addEventListener('focusout',function(){ setTimeout(render,0); });

function pickRow(tr){ if(tr&&tr.classList.contains('pick')){ s.N=Math.round(parseFloat(tr.dataset.n)); render(); } }
$('ladder').addEventListener('click',function(e){pickRow(e.target.closest('tr'))});
$('ladder').addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){e.preventDefault();pickRow(e.target.closest('tr'))} });

document.querySelectorAll('[data-round]').forEach(function(b){
  b.addEventListener('click',function(){
    var m=+b.dataset.round, x=calc(s).rin, y;
    if(m===10) y=Math.round(x/10)*10;
    else if(m===100) y=Math.round(x/100)*100;
    else y=Math.round((x-m)/100)*100+m;
    s.R=y/(1+s.vat/100); render();
  });
});

$('save').addEventListener('click',function(){
  var snap=JSON.parse(JSON.stringify(s));
  var i=saved.findIndex(function(it){return it.name===snap.name});
  if(i>=0) saved[i]=snap; else saved.push(snap);
  render(); flash(this,'Sparad');
});
$('saved').addEventListener('click',function(e){
  var b=e.target.closest('button'); if(!b) return;
  if(b.dataset.load!==undefined){ s=JSON.parse(JSON.stringify(saved[+b.dataset.load])); fill(); render(); window.scrollTo({top:0}); }
  else if(b.dataset.del!==undefined){ saved.splice(+b.dataset.del,1); render(); }
});
$('copy').addEventListener('click',function(){
  var c=calc(s), btn=this;
  var t=[s.name,
    'Inköp: '+fmt(s.price,2)+' '+s.cur+(s.cur==='SEK'?'':' à '+fmt(c.rate,4)+' kr'),
    'Självkostnad: '+kr(c.cost),
    'ÅF-pris netto: '+kr(s.N)+(s.campaign?' (efter kampanjrabatt '+kr(c.neff)+')':''),
    'TB: '+kr(c.tb)+' · TG: '+pct(c.tg)+' · Påslag: '+pct(c.markup),
    'Rek. konsumentpris: '+kr(s.R)+' exkl. moms, '+kr(c.rin)+' inkl. moms',
    'ÅF-rabatt: '+pct(c.d)+' · ÅF:s marginal: '+pct(c.af)].join('\n');
  try{ navigator.clipboard.writeText(t).then(function(){flash(btn,'Kopierad')},function(){flash(btn,'Gick inte att kopiera')}); }
  catch(e){ flash(btn,'Gick inte att kopiera'); }
});
function flash(b,msg){var o=b.dataset.o||(b.dataset.o=b.textContent); b.textContent=msg; setTimeout(function(){b.textContent=o},1400)}

fill(); render();
})();
</script>
</body>
</html>
